{
  "name": "squeekville",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts vitest.config.ts \"test/*.test.ts\" test/browser.mjs \"scripts/*.mjs\""
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.4.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@tanstack/react-query": "^5.105.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.14",
    "wagmi": "^3.7.9"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
